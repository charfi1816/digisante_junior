{% extends 'base.html.twig' %}

{% block title %}Mes enfants | Digi-Santé Junior{% endblock %}

{% block body %}
    <main class="container py-5">
        <h1 class="mb-4">Mes enfants</h1>

        {% for child in children %}
            <div class="card mb-3">
                <div class="card-body">
                    <h2 class="h4">
                        {{ child.firstName }} {{ child.lastName }}
                    </h2>

                    <p class="mb-1">
                        Avatar : {{ child.avatar }}
                    </p>

                    <p class="mb-0">
                        Limite quotidienne :
                        {{ child.dailyScreenLimit }} minutes
                    </p>
                </div>
            </div>
        {% else %}
            <p>Vous n'avez pas encore ajouté d'enfant.</p>
        {% endfor %}
    </main>
{% endblock %}
