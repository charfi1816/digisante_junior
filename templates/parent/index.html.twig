{% extends 'base.html.twig' %}

{% block title %}Mes enfants | Digi-Santé Junior{% endblock %}

{% block body %}

    {% for message in app.flashes('success') %}
        <div class="container mt-3">
            <div class="alert alert-success" role="alert">
                {{ message }}
            </div>
        </div>
    {% endfor %}

    <main class="container py-5">

        <div class="children-header">
            <div>
                <h1>Mes enfants</h1>
                <p>Gérez les profils de vos enfants.</p>
            </div>

            <a href="{{ path('app_parent_child_new') }}" class="btn btn-primary">
                Ajouter un enfant
            </a>
        </div>

        <div class="children-list">
            {% for child in children %}

                <article class="children-card">
                    <div class="children-card-avatar">
                        <img
                            src="{{ asset('images/avatars/' ~ child.avatar ~ '.svg') }}"
                            alt="Avatar de {{ child.firstName }}"
                            class="children-avatar-image"
                        >
                    </div>

                    <h2>{{ child.firstName }} {{ child.lastName }}</h2>
                    <p>
                        Identifiant:
                        <strong>{{ child.account.username }}</strong>
                    </p>

                    <p>
                        Limite quotidienne :
                        <strong>{{ child.dailyScreenLimit }} minutes</strong>
                    </p>
                    {% set todayEntry = null %}

                    {% for entry in child.journalEntries %}
                        {% if entry.date|date('Y-m-d') == 'now'|date('Y-m-d') %}
                            {% set todayEntry = entry %}
                        {% endif %}
                    {% endfor %}

                    <p>
                        Temps déclaré aujourd'hui :
                        <strong>
                            {% if todayEntry %}
                                {{ todayEntry.totalMinutes }} minutes
                            {% else %}
                                Non renseigné
                            {% endif %}
                        </strong>
                    </p>
                </article>

            {% else %}
                <p>Vous n'avez pas encore ajouté d'enfant.</p>
            {% endfor %}
        </div>

    </main>
{% endblock %}
