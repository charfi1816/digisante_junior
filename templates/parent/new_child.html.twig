{% extends 'base.html.twig' %}

{% block title %}Ajouter un enfant | Digi-Santé Junior{% endblock %}

{% block body %}
    <main class="container py-5">
        <div class="child-form-container">
            <a href="{{ path('app_parent') }}" class="login-switch-link">
                Retour à mes enfants
            </a>

            <div class="card rounded-4 shadow-sm mt-3">
                <div class="card-body p-4 p-md-5">
                    <h1 class="h2 mb-3">Ajouter un enfant</h1>

                    <p class="text-secondary mb-4">
                        Renseignez les informations de votre enfant
                        pour créer son profil.
                    </p>

                    {{ form_start(form) }}

                    {{ form_row(form.firstName) }}
                    {{ form_row(form.lastName) }}
                    {{ form_row(form.birthDate) }}

                    <div class="mb-4">
                        {{ form_label(form.avatar) }}

                        <div class="avatar-options">
                            {% for avatar in form.avatar %}
                                <label class="avatar-option">
                                    {{ form_widget(avatar) }}

                                    <img
                                        src="{{ asset('images/avatars/' ~ avatar.vars.value ~ '.svg') }}"
                                        alt="{{ avatar.vars.label }}"
                                    >

                                    <span>{{ avatar.vars.label }}</span>
                                </label>
                            {% endfor %}
                        </div>

                        {{ form_errors(form.avatar) }}
                    </div>

                    {{ form_row(form.dailyScreenLimit) }}
                    {{ form_row(form.password) }}

                    <button type="submit" class="btn btn-primary mt-3">
                        Créer le profil et le compte
                    </button>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </main>
{% endblock %}
