{% extends 'base.html.twig' %}

{% block title %}Ajouter un enfant | Digi-Santé Junior{% endblock %}

{% block body %}
    <main class="container py-5">
        <h1 class="mb-4">Ajouter un enfant</h1>

        <div class="card">
            <div class="card-body">
                {{ form_start(form) }}

                {{ form_widget(form) }}

                <button type="submit" class="btn btn-primary mt-3">
                    Enregistrer
                </button>

                {{ form_end(form) }}
            </div>
        </div>

        <a href="{{ path('app_parent') }}" class="btn btn-link mt-3">
            Retour à mes enfants
        </a>
    </main>
{% endblock %}
