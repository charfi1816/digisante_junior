{% extends 'base.html.twig' %}

{% block title %}Connexion enfant | Digi-Santé Junior{% endblock %}

{% block body %}
    <section class="container py-5">

        <div class="mx-auto text-center mb-4">
            <img
                src="{{ asset('images/icons/digi.svg') }}"
                alt=""
                class="login-child-avatar"
            >

            <h1 class="h2 fw-bold mt-2 mb-2">
                Coucou, c'est toi ?
            </h1>

            <p class="text-secondary">
                Entre ton identifiant et ton mot de passe.
            </p>
        </div>

        <div class="mx-auto bg-white rounded-4 shadow-sm p-4 p-md-5 login-card">

            {% if error %}
                <div class="alert alert-danger" role="alert">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}">
                <input type="hidden" name="_target_path" value="{{ path('app_child') }}">

                <div class="mb-3">
                    <label for="username" class="form-label fw-semibold">
                        Mon identifiant
                    </label>

                    <input
                        type="text"
                        id="username"
                        name="_username"
                        class="form-control"
                        value="{{ last_username }}"
                        placeholder="Par exemple : lea"
                        autocomplete="username"
                        required
                        autofocus
                    >
                </div>

                <div class="mb-4">
                    <label for="password" class="form-label fw-semibold">
                        Mon mot de passe
                    </label>

                    <input
                        type="password"
                        id="password"
                        name="_password"
                        class="form-control"
                        autocomplete="current-password"
                        required
                    >
                </div>

                <input
                    type="hidden"
                    name="_csrf_token"
                    value="{{ csrf_token('authenticate') }}"
                >

                <button type="submit" class="btn btn-primary w-100">
                    C'est parti !
                </button>

            </form>

        </div>

        <p class="text-center mt-4">
            <a href="{{ path('app_login_parent') }}" class="login-switch-link">
                Je suis un parent
            </a>
        </p>

    </section>
{% endblock %}
