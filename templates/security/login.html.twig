{% extends 'base.html.twig' %}

{% block title %}Connexion parent | Digi-Santé Junior{% endblock %}

{% block body %}
    <main class="container py-5">

        <div class="mx-auto bg-white rounded-4 shadow-sm p-4 p-md-5 login-card">

            <h1 class="h2 text-center fw-bold mb-3">
                Espace parent
            </h1>

            <p class="text-center text-secondary mb-4">
                Connectez-vous à votre compte parent.
            </p>

            {% if error %}
                <div class="alert alert-danger" role="alert">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}">
                <input type="hidden" name="_target_path" value="{{ path('app_parent') }}">

                <div class="mb-3">
                    <label for="email" class="form-label fw-semibold">
                        Adresse e-mail
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="_username"
                        class="form-control"
                        value="{{ last_username }}"
                        placeholder="parent@exemple.fr"
                        autocomplete="email"
                        required
                        autofocus
                    >
                </div>

                <div class="mb-4">
                    <label for="password" class="form-label fw-semibold">
                        Mot de passe
                    </label>

                    <input
                        type="password"
                        id="password"
                        name="_password"
                        class="form-control"
                        autocomplete="current-password"
                        required
                    >
                </div>

                <input
                    type="hidden"
                    name="_csrf_token"
                    value="{{ csrf_token('authenticate') }}"
                >

                <button type="submit" class="btn btn-primary w-100">
                    Se connecter
                </button>


            </form>

            <p class="text-center mt-4 mb-2">
                Pas encore de compte ?
                <a href="{{ path('app_registration') }}" class="login-switch-link">
                    Créer un compte parent
                </a>
            </p>

            <p class="text-center mb-0">
                <a href="{{ path('app_login_child') }}" class="login-switch-link">
                    Accéder à l'espace enfant
                </a>
            </p>
        </div>

    </main>
{% endblock %}
