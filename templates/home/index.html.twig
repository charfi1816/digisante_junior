{% extends 'base.html.twig' %}

{% block title %}Accueil | Digi-Santé Junior{% endblock %}

{% block body %}
    <main class="home-hero">
        <div class="container">

            <div class="home-hero-content">

                <div class="home-hero-left">
                    <span class="home-badge">
                        Pour les 8 à 14 ans
                    </span>

                    <h1 class="home-title">
                        Mieux vivre avec les écrans,
                        <span class="home-title-accent">
                            un jour à la fois.
                        </span>
                    </h1>

                    <p class="home-intro">
                        Découvre comment mieux comprendre tes habitudes
                        numériques et prendre soin de ton bien-être
                        au quotidien.
                    </p>

                    <ul class="home-highlights">
                        <li>
                            <span class="home-highlight-icon" aria-hidden="true">
                                <img
                                    src="{{ asset('images/icons/check-circle.svg') }}"
                                    alt=""
                                >
                            </span>
                            <span>Un espace adapté à ton âge</span>
                        </li>

                        <li>
                            <span class="home-highlight-icon" aria-hidden="true">
                                <img
                                    src="{{ asset('images/icons/check-circle.svg') }}"
                                    alt=""
                                >
                            </span>
                            <span>Des outils simples à utiliser</span>
                        </li>

                        <li>
                            <span class="home-highlight-icon" aria-hidden="true">
                                <img
                                    src="{{ asset('images/icons/check-circle.svg') }}"
                                    alt=""
                                >
                            </span>
                            <span>Des conseils adaptés à tes besoins</span>
                        </li>
                    </ul>
                </div>

                <div class="home-hero-right">
                    <div class="home-visual-card">

                        <div class="home-digi-heading">
                            <div class="home-digi-icon" aria-hidden="true">
                                <img
                                    src="{{ asset('images/icons/digi.svg') }}"
                                    alt=""
                                    class="home-digi-image"
                                >
                            </div>

                            <div>
                                <h2 class="home-visual-title">
                                    Salut, moi c'est Digi !
                                </h2>

                                <p class="home-digi-subtitle">
                                    Ton compagnon du quotidien
                                </p>
                            </div>
                        </div>

                        <p class="home-visual-text">
                            Je t'aide à mieux comprendre tes habitudes
                            numériques et à prendre soin de toi,
                            à ton rythme.
                        </p>

                    </div>
                </div>

            </div>

            <section
                class="home-benefits"
                aria-label="Découvrir Digi-Santé Junior"
            >

                <article class="home-benefit-card">
                    <div class="home-benefit-icon" aria-hidden="true">
                        <img
                            src="{{ asset('images/icons/journal.svg') }}"
                            alt=""
                            class="home-feature-icon"
                        >
                    </div>

                    <h2>Mon journal</h2>

                    <p>
                        Je note mon temps d'écran chaque jour.
                    </p>
                </article>

                <article class="home-benefit-card">
                    <div class="home-benefit-icon" aria-hidden="true">
                        <img
                            src="{{ asset('images/icons/corps.svg') }}"
                            alt=""
                            class="home-feature-icon"
                        >
                    </div>

                    <h2>Mon corps</h2>

                    <p>
                        Je signale mes gênes sur une silhouette interactive.
                    </p>
                </article>

                <article class="home-benefit-card">
                    <div class="home-benefit-icon" aria-hidden="true">
                        <img
                            src="{{ asset('images/icons/conseils.svg') }}"
                            alt=""
                            class="home-feature-icon"
                        >
                    </div>

                    <h2>Mes conseils</h2>

                    <p>
                        Je découvre des recommandations adaptées à mes besoins.
                    </p>
                </article>

                <article class="home-benefit-card">
                    <div class="home-benefit-icon" aria-hidden="true">
                        <img
                            src="{{ asset('images/icons/apprendre.svg') }}"
                            alt=""
                            class="home-feature-icon"
                        >
                    </div>

                    <h2>J'apprends</h2>

                    <p>
                        Je découvre des articles, des vidéos et des exercices
                        pour prendre soin de moi.
                    </p>
                </article>

            </section>

        </div>
    </main>
{% endblock %}
