{% extends 'base.html.twig' %}

{% block title %}Accueil | Digi-Santé Junior{% endblock %}

{% block body %}
    <main class="home-hero">
        <div class="container">

            <div class="home-hero-content">

                <div class="home-hero-left">
                    <span class="home-badge">Pour les 8 à 14 ans</span>

                    <h1 class="home-title">
                        Mieux vivre avec les écrans, un jour à la fois.
                    </h1>

                    <p class="home-intro">
                        Comprends mieux tes habitudes numériques et prends soin de ton bien-être au quotidien.
                    </p>

                    <div class="home-actions">
                        <a href="#" class="btn home-child-button">
                            Je suis un enfant
                        </a>

                        <a href="#" class="btn home-parent-button">
                            Je suis un parent
                        </a>
                    </div>

                    <p class="home-signup">
                        Pas encore de compte ?
                        <a href="#">Inscrivez-vous gratuitement</a>
                    </p>
                </div>

                <div class="home-hero-right">
                    <div class="home-visual">
                        <div class="home-visual-card">
                            <h2 class="home-visual-title">
                                Salut, moi c’est Digi !
                            </h2>

                            <p class="home-visual-text">
                                Je t’accompagne chaque jour pour mieux comprendre tes habitudes numériques.
                            </p>

                            <div class="home-visual-features">
                                <div class="home-visual-feature">
                                    <span>Tes écrans</span>
                                </div>

                                <div class="home-visual-feature">
                                    <span>Ton corps</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <section class="home-benefits">
                <div class="home-benefit-card">
                    <img
                        src="{{ asset('images/icons/recommendation.svg') }}"
                        alt=""
                        class="home-feature-icon"
                    >
                    <h2>Des conseils sur mesure</h2>

                    <p>
                        Des recommandations adaptées pour adopter de meilleures habitudes numériques.
                    </p>
                </div>

                <div class="home-benefit-card">
                    <img
                        src="{{ asset('images/icons/parent-tracking.svg') }}"
                        alt=""
                        class="home-feature-icon"
                    >
                    <h2>Un suivi clair pour les parents</h2>

                    <p>
                        Suivez simplement les habitudes numériques et le bien-être de votre enfant.
                    </p>
                </div>

                <div class="home-benefit-card">
                    <img
                        src="{{ asset('images/icons/positive.svg') }}"
                        alt=""
                        class="home-feature-icon"
                    >
                    <h2>Un ton toujours positif</h2>

                    <p>
                        Des conseils encourageants pour aider les enfants à progresser sans culpabiliser.
                    </p>
                </div>
            </section>
        </div>

    </main>
{% endblock %}
