{% extends 'base.html.twig' %}

{% block title %}Gestion des contenus bien-être{% endblock %}

{% block body %}
    <div class="container mt-4">

        <h1 class="text-center mb-4">
            Gestion des contenus bien-être
        </h1>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success" role="alert">
                {{ message }}
            </div>
        {% endfor %}


        <div class="d-flex justify-content-end mb-3">
            <a href="{{ path('admin_wellness_content_new') }}"
               class="btn btn-primary">
                Ajouter un contenu
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                <tr>
                    <th>Titre</th>
                    <th>Type</th>
                    <th>Date de création</th>
                    <th>Actions</th>
                </tr>
                </thead>

                <tbody>
                {% for wellness_content in wellness_contents %}
                    <tr>
                        <td>{{ wellness_content.title }}</td>
                        <td>{{ wellness_content.type }}</td>
                        <td>
                            {{ wellness_content.createdAt ? wellness_content.createdAt|date('d/m/Y') : '' }}
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <a href="{{ path('admin_wellness_content_show', {'id': wellness_content.id}) }}"
                                   class="btn btn-sm btn-outline-primary">
                                    Voir
                                </a>

                                <a href="{{ path('admin_wellness_content_edit', {'id': wellness_content.id}) }}"
                                   class="btn btn-sm btn-primary">
                                    Modifier
                                </a>

                                {{ include('admin/wellness_content/_delete_form.html.twig') }}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td class="text-center py-4">
                            Aucun contenu trouvé.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="mt-4">
            <a href="{{ path('admin_home') }}" class="btn btn-primary">
                Retour à l'administration
            </a>
        </div>

    </div>
{% endblock %}
