<form method="post"
      action="{{ path('admin_wellness_content_delete', {'id': wellness_content.id}) }}"
      onsubmit="return confirm('Voulez-vous vraiment supprimer ce contenu ?');"
      class="m-0">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ wellness_content.id) }}">
    <button class="btn btn-danger">Supprimer</button>
</form>
