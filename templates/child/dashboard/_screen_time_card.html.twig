<section class="text-center">
    <h2 class="h4 mb-3">Mon temps d'écran</h2>

    {% if todayJournal %}
        <p class="screen-time-summary text-center mb-2">
            <strong class="screen-time-value">
                {{ todayJournal.totalMinutes }} min
            </strong>
        </p>

        <p class="text-muted mb-3">
            Limite quotidienne : {{ child.dailyScreenLimit }} min
        </p>

        <div class="progress screen-progress mb-2">
            <div
                class="progress-bar {{ todayJournal.totalMinutes > child.dailyScreenLimit ? 'bg-warning' : 'bg-accent' }}"
                style="width: {{ percentage }}%;"
                role="progressbar"
                aria-label="Progression du temps d'écran"
                aria-valuenow="{{ todayJournal.totalMinutes }}"
                aria-valuemin="0"
                aria-valuemax="{{ child.dailyScreenLimit }}"
            ></div>
        </div>

        <div class="d-flex justify-content-between mb-3">
            <small class="text-muted">0 min</small>
            <small class="text-muted">{{ child.dailyScreenLimit }} min</small>
        </div>

        {% if todayJournal.totalMinutes <= child.dailyScreenLimit %}
            <p class="mb-0">
                Bravo, tu respectes ta limite !
            </p>
        {% else %}
            <p class="mb-0">
                Tu as dépassé ta limite. Pense à faire une pause !
            </p>
        {% endif %}
    {% else %}
        <p class="text-muted mb-0">
            Tu n'as pas encore rempli ton journal aujourd'hui.
        </p>
    {% endif %}
</section>
