{% extends 'base.html.twig' %}

{% block title %}Mon journal | Digi-Santé Junior{% endblock %}

{% block body %}
    <main class="container py-4 child-dashboard">
        <h1 class="mb-3">Mon journal du jour</h1>

        <p class="text-muted mb-4">
            Prends quelques minutes pour raconter ta journée !
        </p>

        <div class="card">
            <div class="card-body">
                {{ form_start(form) }}

                {% include 'child/journal/_screen_card.html.twig' %}

                <section class="mt-5">
                    {% include 'child/journal/_pain_section.html.twig' %}
                </section>

                <button type="submit" class="btn btn-primary mt-4">
                    Enregistrer mon journal
                </button>

                {{ form_end(form) }}
            </div>
        </div>
    </main>
{% endblock %}
