{% set screens = {
    tvScreen: 'Télévision',
    pcScreen: 'Ordinateur',
    phoneScreen: 'Téléphone',
    tabletScreen: 'Tablette',
    consoleScreen: 'Console de jeux',
    otherScreen: 'Autres écrans'
} %}

<h2 class="journal-section-title d-flex align-items-center gap-2">
    <img src="{{ asset('images/icons/monitor.svg') }}"
         alt=""
         class="journal-title-icon">
    Mes écrans aujourd'hui
</h2>

<p class="text-muted mb-4">
    Combien de minutes as-tu passé sur chaque écran ?
</p>

<div class="d-flex flex-wrap gap-3">
    {% for name, label in screens %}
        <div class="journal-screen-item">
            {{ form_row(attribute(form, name), {label: label}) }}
        </div>
    {% endfor %}
</div>

<p class="journal-total mt-4 mb-0">
    Temps total :
    <strong class="screen-total">0 minutes</strong>
</p>
