<h2 class="journal-section-title d-flex align-items-center gap-2">
    <img src="{{ asset('images/icons/heart-pulse.svg') }}"
         alt=""
         class="journal-title-icon">
    Comment va mon corps ?
</h2>

<p class="text-muted mb-4">
    As-tu ressenti une douleur ? Indique son intensité pour chaque zone.
</p>

<div class="row g-3">
    {% for field in form.painZones %}
        <div class="col-12 col-md-6">
            <div class="pain-zone-card">
                {{ form_row(field) }}
            </div>
        </div>
    {% endfor %}
</div>
