{% extends 'base.html.twig' %}

{% block title %}Mon journal | Digi-Santé Junior{% endblock %}

{% block body %}
    <main class="container py-5 child-dashboard">

        <h1 class="mb-3">Mon journal d'écran</h1>

        <p class="text-muted mb-4">
            Indique le temps passé devant chaque écran aujourd'hui, en minutes.
        </p>

        <div class="card rounded-4 shadow-sm">
            <div class="card-body p-4">

                <h2 class="h4 mb-4">Mes temps d'écran</h2>

                {{ form_start(form) }}

                <div class="row g-3">

                    {% for field in form %}
                        {% if field.vars.name != '_token' %}
                            <div class="col-md-4">
                                <div class="journal-screen-card">
                                    {{ form_row(field) }}
                                </div>
                            </div>
                        {% endif %}
                    {% endfor %}

                </div>

                <button type="submit" class="btn btn-primary mt-4">
                    Enregistrer mon journal
                </button>

                {{ form_end(form) }}

            </div>
        </div>

        <a href="{{ path('app_child') }}" class="btn btn-link mt-3">
            ← Retour à mon espace
        </a>

    </main>
{% endblock %}
