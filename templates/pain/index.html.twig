{% extends 'base.html.twig' %}

{% block title %}Mon corps - Digi-Santé Junior{% endblock %}

{% block body %}
    <main class="container child-dashboard py-4">

        <h1 class="mb-3">Comment se sent ton corps ?</h1>

        <p class="text-secondary mb-4">
            Choisis une partie du corps si tu as mal.
            Si tu n'as mal nulle part, tu peux terminer ton journal.
        </p>

        {% set zones = {
            eyes: 'Yeux',
            neck: 'Cou / nuque',
            back: 'Dos',
            hands: 'Mains / poignets'
        } %}


        <div class="card">
            <div class="card-body">

                <h2 class="mb-3">Où as-tu mal ?</h2>

                <div class="d-flex flex-wrap gap-3">
                    {% for code, label in zones %}
                        {% include 'pain/_zone_card.html.twig' %}
                    {% endfor %}
                </div>


                {{ form_start(form) }}

                {{ form_widget(form.painZones) }}

                <button type="submit" class="btn btn-primary mt-4">
                    Terminer mon journal
                </button>

                {{ form_end(form) }}

            </div>
        </div>


        {% include 'pain/_pain_modal.html.twig' %}

    </main>
{% endblock %}
